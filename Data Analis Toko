      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================\n",
        "# 1. MEMBACA DATASET\n",
        "# ==========================================\n",
        "\n",
        "file_path = '/content/ecommerce_sales.xlsx'\n",
        "\n",
        "raw = pd.read_excel(file_path)\n",
        "\n",
        "df = raw.iloc[:, 0].str.split(',', expand=True)\n",
        "\n",
        "df.columns = raw.columns[0].split(',')\n",
        "\n",
        "# ==========================================\n",
        "# 2. DATA CLEANING\n",
        "# ==========================================\n",
        "\n",
        "df['unit_price'] = pd.to_numeric(df['unit_price'])\n",
        "df['quantity'] = pd.to_numeric(df['quantity'])\n",
        "df['discount'] = pd.to_numeric(df['discount'])\n",
        "\n",
        "df['order_date'] = pd.to_datetime(\n",
        "    df['order_date']\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 3. GROSS SALES\n",
        "# ==========================================\n",
        "\n",
        "df['Gross Sales'] = (\n",
        "    df['unit_price'] * df['quantity']\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 4. NET SALES\n",
        "# ==========================================\n",
        "\n",
        "df['Net Sales'] = (\n",
        "    df['Gross Sales']\n",
        "    * (1 - df['discount'])\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# 5. BULAN\n",
        "# ==========================================\n",
        "\n",
