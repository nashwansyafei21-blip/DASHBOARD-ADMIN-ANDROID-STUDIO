        "print(\"\\n===== 24. HARGA RATA-RATA TERTINGGI =====\")\n",
        "display(harga_produk)\n",
        "\n",
        "print(\n",
        "    \"Produk dengan harga rata-rata tertinggi:\",\n",
        "    harga_produk.iloc[0]['product']\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Harga rata-rata: \"\n",
        "    f\"Rp{harga_produk.iloc[0]['Rata_Rata_Harga']:,.0f}\"\n",
        ")\n",
        "\n",
        "\n",
        "# =====================================================\n",
        "# 25. PRODUK PALING SERING MENDAPATKAN DISKON\n",
        "# =====================================================\n",
        "\n",
        "produk_diskon = (\n",
        "    df[df['discount'] > 0]\n",
        "    .groupby('product')\n",
        "    .agg(\n",
        "        Jumlah_Transaksi_Diskon=('discount', 'count'),\n",
        "        Rata_Rata_Diskon=('discount', 'mean')\n",
        "    )\n",
        "    .reset_index()\n",
        "    .sort_values(\n",
        "        'Jumlah_Transaksi_Diskon',\n",
        "        ascending=False\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\n===== 25. PRODUK PALING SERING DISKON =====\")\n",
        "display(produk_diskon)\n",
        "\n",
        "print(\n",
        "    \"Produk paling sering mendapatkan diskon:\",\n",
        "    produk_diskon.iloc[0]['product']\n",
        ")\n",
        "\n",
        "\n",
        "# =====================================================\n",
        "# 26. PERFORMA KATEGORI\n",
        "# =====================================================\n",
        "\n",
        "kategori_performa = (\n",
        "    df.groupby('category')\n",
        "      .agg(\n",
        "          Total_Quantity=('quantity', 'sum'),\n",
        "          Total_Gross_Sales=('Gross Sales', 'sum'),\n",
        "          Total_Net_Sales=('Net Sales', 'sum'),\n",
        "          Jumlah_Transaksi=('order_id', 'nunique'),\n",
        "          Rata_Rata_Harga=('unit_price', 'mean')\n",
        "      )\n",
        "      .reset_index()\n",
        "      .sort_values(\n",
        "          'Total_Net_Sales',\n",
        "          ascending=False\n",
        "      )\n",
        ")\n",
        "\n",
        "print(\"\\n===== 26. PERFORMA KATEGORI =====\")\n",
        "display(kategori_performa)\n",
        "\n",
        "\n",
        "# =====================================================\n",
        "# 27. QUANTITY VS REVENUE\n",
        "# =====================================================\n",
        "\n",
        "produk_performa = (\n",
        "    df.groupby('product')\n",
        "      .agg(\n",
        "          Total_Quantity=('quantity', 'sum'),\n",
        "          Total_Net_Sales=('Net Sales', 'sum')\n",
        "      )\n",
        "      .reset_index()\n",
        ")\n",
        "\n",
        "produk_performa['Ranking_Quantity'] = (\n",
        "    produk_performa['Total_Quantity']\n",
        "    .rank(\n",
        "        ascending=False,\n",
        "        method='min'\n",
        "    )\n",
        "    .astype(int)\n",
        ")\n",
        "\n",
        "produk_performa['Ranking_Revenue'] = (\n",
        "    produk_performa['Total_Net_Sales']\n",
        "    .rank(\n",
        "        ascending=False,\n",
        "        method='min'\n",
        "    )\n",
        "    .astype(int)\n",
        ")\n",
        "\n",
        "print(\"\\n===== 27. QUANTITY VS REVENUE =====\")\n",
        "display(\n",
        "    produk_performa.sort_values(\n",
        "        'Ranking_Revenue'\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# =====================================================\n",
        "# KORELASI\n",
        "# =====================================================\n",
        "\n",
        "korelasi = (\n",
        "    produk_performa['Total_Quantity']\n",
        "    .corr(\n",
        "        produk_performa['Total_Net_Sales']\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"\\nKorelasi Quantity vs Net Sales: {korelasi:.2f}\"\n",
        ")\n",
        "\n",
        "\n",
